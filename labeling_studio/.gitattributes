# 기본은 git 이 알아서 정규화한다
* text=auto

# 윈도우 스크립트는 CRLF 여야 한다.
# cmd.exe 는 LF 만 있는 .bat 에서 줄 동기화를 잃는 일이 있다.
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 소스는 LF 로 통일
*.py    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.txt   text eol=lf

# 바이너리 (저장소에 들어올 일은 없지만 실수 방지)
*.pt    binary
*.jpg   binary
*.png   binary
*.zip   binary
